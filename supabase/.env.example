# Settings for the otd-dash Edge Function (the data check).
# Copy to supabase/.env, fill in, then load into Supabase with:
#   supabase secrets set --env-file supabase/.env --project-ref njgctrmitailbvjtyeiz
# Never commit supabase/.env.

# Required: this dashboard's app ID (client_id) at auth.metago.health
METAGO_AUDIENCE=otd-midweek

# Required: where the page is hosted (scheme + host, no path). Comma-separate several.
ALLOWED_ORIGINS=https://shereenbajaj.github.io

# Optional: who may see the data. "*" = anyone who can sign in.
ALLOWED_EMAIL_DOMAINS=metago.health

# Optional: limit to these token roles (comma-separated). Empty = any role.
ALLOWED_ROLES=

# Optional: the MetaGo auth service.
METAGO_ISSUER=https://auth.metago.health

# Not needed: Supabase supplies SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY to the function itself.
